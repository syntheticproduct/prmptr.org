{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "prmptr.org",
  "version": "0.1.0",
  "identifier": "org.prmptr.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "prmptr.org",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#161514"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Camille Lambert",
    "homepage": "https://github.com/syntheticproduct/prmptr.org",
    "copyright": "Copyright © 2026 Camille Lambert",
    "category": "DeveloperTool",
    "shortDescription": "WYSIWYG markdown editor for LLM prompt engineers.",
    "longDescription": "prmptr.org is a desktop companion for prompt engineering: write, version, and analyse reusable LLM prompts. XML tags and {{variables}} are first-class citizens, byte-perfect markdown round-trip via remark, structural awareness, and a Claude Code session browser. MIT-licensed open source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document — open with prmptr.org",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Plain text",
        "description": "Plain text — open with prmptr.org",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "windows": {
      "wix": {
        "upgradeCode": "771da6f7-0dcc-4ee0-9e02-f798df3f7bf5"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "allowDowngrades": false
    },
    "linux": {
      "deb": {
        "section": "editors"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
