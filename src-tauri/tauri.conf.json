{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "prmptr.org",
  "version": "0.1.0",
  "identifier": "org.prmptr.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "prmptr.org",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#161514"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document — open with prmptr.org",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Plain text",
        "description": "Plain text — open with prmptr.org",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
